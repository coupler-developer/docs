{
  "name": "docs",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "resolutions": {
    "js-yaml": "4.2.0",
    "markdown-it": "14.2.0",
    "picomatch": "2.3.2"
  },
  "devDependencies": {
    "markdown-it": "14.2.0",
    "markdownlint-cli2": "0.17.2"
  },
  "scripts": {
    "release:preflight": "node scripts/release-preflight.mjs",
    "test:release-preflight": "node scripts/docs-validation-runner.mjs task test:release-preflight",
    "test:docs-structure": "node scripts/docs-validation-runner.mjs task test:docs-structure",
    "test:document-lifecycle": "node scripts/docs-validation-runner.mjs task test:document-lifecycle",
    "test:agent-workflow": "node scripts/docs-validation-runner.mjs task test:agent-workflow",
    "test:docs-validation-config": "node scripts/docs-validation-runner.mjs task test:docs-validation-config",
    "test:docs-validation-runner": "node scripts/docs-validation-runner.mjs task test:docs-validation-runner",
    "test:technical-debt": "node scripts/docs-validation-runner.mjs task test:technical-debt",
    "validate:docs-structure": "node scripts/docs-validation-runner.mjs task validate:docs-structure",
    "validate:document-lifecycle": "node scripts/docs-validation-runner.mjs task validate:document-lifecycle",
    "validate:agent-workflow": "node scripts/docs-validation-runner.mjs task validate:agent-workflow",
    "validate:docs-sensitive": "node scripts/docs-validation-runner.mjs task validate:docs-sensitive",
    "generate:logical-data-model": "node scripts/validate-logical-data-model.mjs --write-views && node scripts/validate-logical-data-model.mjs --write-catalog",
    "generate:logical-data-model-catalog": "node scripts/validate-logical-data-model.mjs --write-catalog",
    "validate:logical-data-model": "node scripts/docs-validation-runner.mjs task validate:logical-data-model",
    "validate:technical-debt": "node scripts/docs-validation-runner.mjs task validate:technical-debt",
    "validate:release-records": "node scripts/docs-validation-runner.mjs task validate:release-records",
    "validate:api-error-docs": "node scripts/docs-validation-runner.mjs task validate:api-error-docs",
    "build:docs": "node scripts/docs-validation-runner.mjs task build:docs",
    "lint:md": "node scripts/docs-validation-runner.mjs task lint:md",
    "test:logical-data-model": "node scripts/docs-validation-runner.mjs task test:logical-data-model",
    "validate:docs-static": "node scripts/docs-validation-runner.mjs static",
    "validate:docs": "node scripts/docs-validation-runner.mjs full",
    "verify": "node scripts/docs-validation-runner.mjs full"
  }
}
